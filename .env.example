# Hanaqaad College — Environment Variables
# Copy this file to env.js and fill in your actual values.
# NEVER commit real keys to Git. Add env.js to .gitignore.

# Supabase Project URL (found in Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable (anon) Key — safe for frontend use
# Found in Supabase Dashboard → Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NEVER put the service_role or secret key in frontend code.
# If you need server-side admin operations, use Supabase Edge Functions.
